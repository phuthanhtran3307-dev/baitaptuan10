section class="hero-section">
    <div class="search-card">
        <h2 class="mb-4" style="font-weight: 700;">Đặt Vé Máy Bay Online</h2>
        
        <form method="get" action="/Flight">
            <div class="trip-type mb-3">
                <label><input type="radio" name="trip" checked> Khứ hồi</label>
                <label><input type="radio" name="trip"> Một chiều</label>
            </div>

            <div class="row g-2">
                <div class="col-lg-3 col-md-6">
                    <div class="input-group-custom">
                        <small>Từ</small>
                        <input type="text" class="form-control-plain" placeholder="Hồ Chí Minh (SGN)">
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="input-group-custom">
                        <small>Đến</small>
                        <input type="text" class="form-control-plain" placeholder="Hà Nội (HAN)">
                    </div>
                </div>
                <div class="col-lg-4 col-md-8">
                    <div class="input-group-custom">
                        <small>Ngày đi - Ngày về</small>
                        <input type="text" class="form-control-plain" placeholder="23-03-2026 - 24-03-2026">
                    </div>
                </div>
                <div class="col-lg-2 col-md-4">
                    <button type="submit" class="btn-search-orange">
                        Tìm chuyến bay
                    </button>
                </div>
            </div>
        </form>
    </div>
</section>