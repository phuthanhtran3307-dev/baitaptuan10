@model IEnumerable<FlightBooking.Models.FlightViewModel>

@{
    ViewData["Title"] = "Kết quả tìm kiếm chuyến bay";
    // Lấy thông tin tìm kiếm từ ViewBag
    var fromCity = ViewBag.From as string ?? "Điểm đi";
    var toCity = ViewBag.To as string ?? "Điểm đến";
    var selectedDate = ViewBag.SelectedDate as string;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
<style>
    .flight-card {
        transition: all 0.3s ease;
        border-radius: 15px;
        background-color: #fff;
        border: 1px solid #f0f0f0;
    }
    .flight-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 25px rgba(0,0,0,0.1) !important;
        border-color: #ffc107; /* Màu vàng giống nút chọn chuyến */
    }
    .plane-line {
        flex: 1;
        border-bottom: 2px dashed #dee2e6;
        height: 1px;
        position: relative;
    }
    .border-start-md {
        border-left: 1px solid #eee;
    }
    @@media (max-width: 768px) {
        .border-start-md { border-left: none; border-top: 1px solid #eee; padding-top: 15px; margin-top: 15px; }
    }
</style>

<div class="container mt-5">
    @* 1. Thanh thông tin hành trình tìm kiếm *@
    <div class="p-4 bg-white rounded-3 shadow-sm mb-4 border-start border-primary border-5">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h3 class="fw-bold text-dark mb-1">
                    <i class="fas fa-plane-departure text-primary me-2"></i>
                    <span class="text-uppercase">@fromCity</span> 
                    <i class="fas fa-arrow-right mx-3 text-muted" style="font-size: 0.9rem;"></i> 
                    <span class="text-uppercase">@toCity</span>
                </h3>
                <p class="text-muted mb-0">
                    <i class="far fa-calendar-alt me-2"></i>Ngày: <strong>@(string.IsNullOrEmpty(selectedDate) ? "Tất cả" : selectedDate)</strong> 
                    <span class="mx-2">|</span> 
                    Tìm thấy <strong>@(Model?.Count() ?? 0)</strong> chuyến bay
                </p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                    <i class="fas fa-search me-1"></i> Đổi tìm kiếm
                </a>
            </div>
        </div>
    </div>

    @* 2. Danh sách các chuyến bay *@
    @if (Model != null && Model.Any())
    {
        @foreach (var flight in Model)
        {
            <div class="card mb-3 border-0 shadow-sm flight-card">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        
                        @* Thông tin hãng *@
                        <div class="col-md-3 mb-3 mb-md-0">
                            <div class="d-flex align-items-center">
                                <div class="bg-light p-3 rounded me-3 text-center" style="min-width: 60px;">
                                    <i class="fas fa-plane text-primary fa-lg"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-0 text-dark">@flight.Airline</h5>
                                    <span class="badge bg-soft-primary text-primary border border-primary-subtle">@flight.FlightNumber</span>
                                </div>
                            </div>
                        </div>
                        
                        @* Lịch trình *@
                        <div class="col-md-6">
                            <div class="row align-items-center text-center">
                                <div class="col-4">
                                    <div class="fs-4 fw-bold text-dark">@flight.DepartureTime.ToString("HH:mm")</div>
                                    <div class="text-secondary small fw-bold text-truncate text-uppercase">@flight.From</div>
                                </div>
                                
                                <div class="col-4">
                                    <div class="d-flex align-items-center">
                                        <div class="plane-line"></div>
                                        <i class="fas fa-plane mx-2 text-muted" style="font-size: 0.8rem;"></i>
                                        <div class="plane-line"></div>
                                    </div>
                                    <small class="text-muted d-block mt-1" style="font-size: 0.7rem;">Bay thẳng</small>
                                </div>

                                <div class="col-4">
                                    <div class="fs-4 fw-bold text-dark">@flight.ArrivalTime.ToString("HH:mm")</div>
                                    <div class="text-secondary small fw-bold text-truncate text-uppercase">@flight.To</div>
                                </div>
                            </div>
                        </div>

                        @* Giá vé & Đặt vé *@
                        <div class="col-md-3 text-md-end border-start-md">
                            <div class="mb-3">
                                <span class="text-muted small">Giá vé cơ bản:</span>
                                <div class="text-danger fs-4 fw-bold">
                                    @flight.Price.ToString("N0") <small class="fs-6">VND</small>
                                </div>
                            </div>
                            
                            @* Truyền tham số để tránh 404 cho Mock Flight *@
                            <a asp-controller="Flight" 
                               asp-action="Details" 
                               asp-route-id="@flight.Id" 
                               asp-route-from="@fromCity"
                               asp-route-to="@toCity"
                               class="btn btn-warning w-100 fw-bold text-white py-2 shadow-sm rounded-pill">
                                 CHỌN CHUYẾN <i class="fas fa-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5 bg-white rounded-3 shadow-sm border">
            <div class="mb-4">
                <i class="fas fa-plane-slash fa-5x text-muted opacity-25"></i>
            </div>
            <h4 class="text-muted fw-bold">Rất tiếc, không tìm thấy chuyến bay nào.</h4>
            <p class="text-secondary">Chúng tôi hiện không có lịch bay cho chặng <strong>@fromCity</strong> - <strong>@toCity</strong> vào ngày này.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-5 rounded-pill shadow-sm">
                <i class="fas fa-home me-2"></i>Quay lại trang chủ
            </a>
        </div>
    }
</div>