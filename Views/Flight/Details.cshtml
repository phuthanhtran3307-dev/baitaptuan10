@* --- FORM ĐIỀU HƯỚNG SANG TRANG THANH TOÁN --- *@
<form asp-controller="Flight" asp-action="FinalizeBooking" method="post">
    @* Quan trọng: Truyền FlightId để xử lý logic gán NULL nếu là ID 999 *@
    <input type="hidden" name="flightId" value="@Model.Id" />
    <input type="hidden" name="amount" value="@Model.Price" />
    
    @* Chống tấn công giả mạo yêu cầu *@
    @Html.AntiForgeryToken()

    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
        <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fas fa-arrow-left me-1"></i> Quay lại
        </a>
        
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <button type="submit" class="btn btn-warning text-white fw-bold px-5 rounded-pill shadow-sm">
                XÁC NHẬN THANH TOÁN <i class="fas fa-check-circle ms-1"></i>
            </button>
        }
        else
        {
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary text-white fw-bold px-5 rounded-pill shadow-sm">
                ĐĂNG KÝ ĐỂ ĐẶT VÉ <i class="fas fa-user-plus ms-1"></i>
            </a>
        }
    </div>
</form>