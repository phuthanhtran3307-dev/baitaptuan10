@model IEnumerable<FlightBooking.Models.Flight>

@{
    ViewData["Title"] = "Quản lý Chuyến bay";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="fas fa-plane-departure me-2"></i>Danh sách Chuyến bay</h2>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="fas fa-plus-circle me-1"></i> Thêm chuyến bay mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã chuyến</th>
                        <th>Điểm đi</th>
                        <th>Điểm đến</th>
                        <th>Khởi hành</th>
                        <th>Giá vé</th>
                        <th>Số ghế trống</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-info">@item.FlightNumber</td>
                            <td>@item.FromCity</td>
                            <td>@item.ToCity</td>
                            <td>@item.DepartureTime.ToString("HH:mm dd/MM/yyyy")</td>
                            <td class="text-danger fw-bold">@item.Price.ToString("N0") VNĐ</td>
                            <td><span class="badge bg-primary">@item.AvailableSeats ghế</span></td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-white">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" 
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa chuyến bay @item.FlightNumber không?');">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>