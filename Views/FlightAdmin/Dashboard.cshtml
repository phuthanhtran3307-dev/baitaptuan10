@model dynamic 

@{
    ViewData["Title"] = "Báo cáo thống kê";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="fas fa-chart-line me-2"></i>Báo cáo Doanh thu & Tồn kho</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Quay lại danh sách</a>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card bg-primary text-white shadow border-0">
                <div class="card-body">
                    <h6 class="text-uppercase small">Tổng doanh thu</h6>
                    <h3 class="fw-bold">@ViewBag.TotalRevenue.ToString("N0") VNĐ</h3>
                    <i class="fas fa-money-bill-wave fa-2x opacity-50 float-end"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card bg-success text-white shadow border-0">
                <div class="card-body">
                    <h6 class="text-uppercase small">Vé đã bán</h6>
                    <h3 class="fw-bold">@ViewBag.TotalTickets vé</h3>
                    <i class="fas fa-ticket-alt fa-2x opacity-50 float-end"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card bg-info text-white shadow border-0">
                <div class="card-body">
                    <h6 class="text-uppercase small">Tổng ghế trống (Tồn kho)</h6>
                    <h3 class="fw-bold">@ViewBag.TotalSeats ghế</h3>
                    <i class="fas fa-couch fa-2x opacity-50 float-end"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-md-12">
            <div class="card shadow border-0">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Biểu đồ doanh thu theo từng chuyến bay</h6>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" style="width: 100%; height: 350px;"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var ctx = document.getElementById('revenueChart').getContext('2d');
            
            // Lấy dữ liệu từ ViewBag được truyền từ Controller
            var labels = @Html.Raw(Json.Serialize(ViewBag.ChartLabels));
            var dataValues = @Html.Raw(Json.Serialize(ViewBag.ChartValues));

            var myChart = new Chart(ctx, {
                type: 'bar', // Kiểu biểu đồ cột
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: dataValues,
                        backgroundColor: 'rgba(13, 110, 253, 0.6)', // Màu xanh Bootstrap
                        borderColor: 'rgba(13, 110, 253, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString() + ' ₫';
                                }
                            }
                        }
                    },
                    plugins: {
                        legend: { display: true, position: 'top' }
                    }
                }
            });
        });
    </script>
}