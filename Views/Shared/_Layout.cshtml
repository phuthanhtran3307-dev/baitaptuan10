<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SHIN Flight Booking</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="custom-navbar shadow-sm" style="background-color: #003580; padding: 10px 0;">
            <div class="container d-flex align-items-center justify-content-between">
                
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="/images/shin.jpg" alt="Logo" height="35" class="me-2" style="border-radius: 5px;"> 
                    <span class="text-white fw-bold fs-4">SHIN.com</span>
                </a> 

                <ul class="nav-links d-none d-lg-flex mb-0 list-unstyled gap-4">
                    <li><a href="#" class="text-white text-decoration-none">Khách sạn</a></li>
                    <li><a href="#" class="text-white text-decoration-none">Tours</a></li>
                    <li><a asp-controller="Flight" asp-action="Index" class="text-white text-decoration-none fw-bold">Vé máy bay</a></li>
                    <li><a href="#" class="text-white text-decoration-none">Vé vui chơi</a></li>
                    <li><a href="#" class="text-white text-decoration-none">Vé tàu</a></li>
                </ul>

                <div class="nav-right d-flex align-items-center">
                    <div class="user-account me-4 text-white d-none d-md-block">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown d-inline">
                                <a href="#" class="text-white text-decoration-none dropdown-toggle px-3 py-2 border border-white rounded-pill" 
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle fa-lg"></i> Chào, @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2" style="border-radius: 12px;">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                            <i class="fas fa-id-card me-2 text-primary"></i>Thông tin cá nhân
                                        </a>
                                    </li>
                                    
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 text-warning fw-bold" asp-controller="Account" asp-action="AdminDashboard">
                                                <i class="fas fa-user-shield me-2"></i>Quản trị hệ thống
                                            </a>
                                        </li>
                                    }
                                    
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item py-2 text-danger fw-bold">
                                                <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Register" class="text-white text-decoration-none border border-white px-3 py-2 rounded-pill">
                                <i class="fas fa-user-circle fa-lg"></i> Đăng nhập / Đăng ký
                            </a>
                        }
                    </div>
                    
                    <div class="hotline-box text-end border-start ps-4 d-none d-sm-block">
                        <div class="phone-number text-white fw-bold"><i class="fas fa-phone-alt"></i> 1900 2087</div>
                        <div class="working-hours text-white-50 small"><i class="far fa-clock"></i> 7h30 → 23h</div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid p-0">
        <main role="main">
            @RenderBody() 
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>