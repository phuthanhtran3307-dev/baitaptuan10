<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SHIN Flight Booking</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .dropdown-menu { animation: fadeIn 0.3s; }
        @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .nav-links a:hover { color: #ffc107 !important; transition: 0.3s; }
        .custom-navbar { z-index: 1050; }
    </style>
</head>
<body>
    <header>
        <nav class="custom-navbar shadow-sm" style="background-color: #003580; padding: 10px 0;">
            <div class="container d-flex align-items-center justify-content-between">
                
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="/images/shin.jpg" alt="Logo" height="35" class="me-2" style="border-radius: 5px;"> 
                    <span class="text-white fw-bold fs-4">SHIN.com</span>
                </a> 

                <ul class="nav-links d-none d-lg-flex mb-0 list-unstyled gap-4">
                    <li><a asp-controller="Home" asp-action="Index" class="text-white text-decoration-none">Khách sạn</a></li>
                    <li><a asp-controller="Home" asp-action="Index" class="text-white text-decoration-none">Tours</a></li>
                    
                    <li>
                        <a asp-controller="Flight" asp-action="Search" class="text-white text-decoration-none fw-bold">
                            <i class="fas fa-plane me-1"></i> Vé máy bay
                        </a>
                    </li>
                    
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li>
                            <a asp-controller="Flight" asp-action="History" class="text-white text-decoration-none">
                                <i class="fas fa-history me-1 text-info"></i> Lịch sử đặt vé
                            </a>
                        </li>
                    }

                    <li><a asp-controller="Home" asp-action="Index" class="text-white text-decoration-none">Vé vui chơi</a></li>
                </ul>

                <div class="nav-right d-flex align-items-center">
                    <div class="user-account me-4 text-white d-none d-md-block">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown d-inline">
                                <a href="#" class="text-white text-decoration-none dropdown-toggle px-3 py-2 border border-white rounded-pill" 
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle fa-lg"></i> Chào, @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2" style="border-radius: 12px; min-width: 220px;">
                                    <li class="px-3 py-2 text-muted small border-bottom">Tài khoản của tôi</li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                            <i class="fas fa-id-card me-2 text-primary"></i>Thông tin cá nhân
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Flight" asp-action="History">
                                            <i class="fas fa-clock-rotate-left me-2 text-success"></i>Lịch sử đặt vé
                                        </a>
                                    </li>
                                    
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li class="px-3 py-2 text-muted small">Quản lý hệ thống</li>
                                        
                                        @* MỤC MỚI THÊM: Dashboard Thống kê *@
                                        <li>
                                            <a class="dropdown-item py-2 text-primary fw-bold" asp-controller="FlightAdmin" asp-action="Dashboard">
                                                <i class="fas fa-chart-line me-2"></i>Báo cáo Thống kê
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item py-2 text-warning fw-bold" asp-controller="FlightAdmin" asp-action="Index">
                                                <i class="fas fa-plane-departure me-2"></i>Quản lý Chuyến bay
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 text-warning fw-bold" asp-controller="Account" asp-action="AdminDashboard">
                                                <i class="fas fa-users-cog me-2"></i>Quản lý Người dùng
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-1">
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100 fw-bold">
                                                <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="text-white text-decoration-none border border-white px-4 py-2 rounded-pill shadow-sm">
                                <i class="fas fa-user-circle fa-lg"></i> Đăng nhập
                            </a>
                        }
                    </div>
                    
                    <div class="hotline-box text-end border-start ps-4 d-none d-sm-block">
                        <div class="phone-number text-white fw-bold"><i class="fas fa-phone-alt"></i> 1900 2087</div>
                        <div class="working-hours text-white-50 small"><i class="far fa-clock"></i> 24/7 Hỗ trợ</div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid p-0">
        <main role="main">
            <div class="container mt-3">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            </div>

            @RenderBody() 
        </main>
    </div>

    <footer class="bg-light py-4 mt-5 border-top">
        <div class="container text-center text-muted">
            <p class="mb-0">&copy; 2026 - SHIN Flight Booking. Phát triển bởi Sinh viên Kỹ thuật.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>