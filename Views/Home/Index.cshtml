@{
    ViewData["Title"] = "Trang chủ - Đặt vé máy bay";
    var today = DateTime.Now.ToString("yyyy-MM-dd");
}

<div class="container-fluid px-0 mb-5">
    <div class="py-5" style="background: linear-gradient(rgba(0, 53, 128, 0.7), rgba(0, 53, 128, 0.7)), url('/images/hero-bg.jpg') no-repeat center center; background-size: cover; min-height: 450px; display: flex; align-items: center;">
        <div class="container text-center">
            <h1 class="text-white fw-bold display-4 mb-3">Khám phá hành trình mới</h1>
            <p class="text-white-50 fs-5 mb-5">Hàng ngàn chuyến bay giá tốt đang chờ đợi bạn</p>

            <div class="card shadow-lg border-0 rounded-4 p-4 mx-auto" style="max-width: 1000px;">
                <form asp-controller="Flight" asp-action="Search" method="get">
                    <div class="row g-3">
                        <div class="col-md-4 text-start">
                            <label class="form-label small fw-bold text-muted text-uppercase">Điểm đi</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-plane-departure text-primary"></i></span>
                                <input type="text" name="from" class="form-control bg-light border-0" placeholder="Hồ Chí Minh" required>
                            </div>
                        </div>
                        <div class="col-md-4 text-start">
                            <label class="form-label small fw-bold text-muted text-uppercase">Điểm đến</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-plane-arrival text-primary"></i></span>
                                <input type="text" name="to" class="form-control bg-light border-0" placeholder="Đà Nẵng" required>
                            </div>
                        </div>
                        <div class="col-md-3 text-start">
                            <label class="form-label small fw-bold text-muted text-uppercase">Ngày đi</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="far fa-calendar-alt text-primary"></i></span>
                                <input type="date" name="date" class="form-control bg-light border-0" value="@today" min="@today">
                            </div>
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="submit" class="btn btn-warning w-100 py-2 shadow-sm text-white">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="mb-4">
        <h3 class="fw-bold text-dark">Điểm đến phổ biến</h3>
        <p class="text-muted">Gợi ý những hành trình tuyệt vời nhất dành cho bạn</p>
    </div>
    
    <div class="row g-4">
        @{
            var destinations = new[] {
                new { Name = "Đà Nẵng", Price = "599.000", Img = "danang.jpg", Tag = "Bán chạy" },
                new { Name = "Phú Quốc", Price = "890.000", Img = "phuquoc.jpg", Tag = "Nghỉ dưỡng" },
                new { Name = "Hà Nội", Price = "750.000", Img = "hanoi.jpg", Tag = "Yêu thích" },
                new { Name = "Đà Lạt", Price = "450.000", Img = "dalat.jpg", Tag = "Giá rẻ" }
            };
        }

        @foreach (var dest in destinations)
        {
            <div class="col-md-3">
                <a asp-controller="Flight" 
                   asp-action="Search" 
                   asp-route-from="Hồ Chí Minh" 
                   asp-route-to="@dest.Name" 
                   asp-route-date="@today" 
                   class="text-decoration-none text-dark d-block h-100">
                    <div class="card border-0 shadow-sm h-100 overflow-hidden rounded-4 card-hover">
                        <div class="position-relative">
                            <img src="/images/@dest.Img" class="card-img-top" style="height: 200px; object-fit: cover;" 
                                 onerror="this.src='https://placehold.co/600x400?text=@dest.Name'">
                            <span class="position-absolute top-0 end-0 m-3 badge bg-primary rounded-pill py-2 px-3">@dest.Tag</span>
                        </div>
                        <div class="card-body p-3">
                            <h6 class="fw-bold mb-1">@dest.Name</h6>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Chỉ từ</span>
                                <span class="text-primary fw-bold fs-5">@dest.Price<small class="ms-1">đ</small></span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<style>
    .card-hover { transition: all 0.3s ease; }
    .card-hover:hover { 
        transform: translateY(-10px); 
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important; 
    }
    .input-group-text { 
        border-top-left-radius: 0.5rem !important; 
        border-bottom-left-radius: 0.5rem !important; 
    }
    .form-control { 
        border-top-right-radius: 0.5rem !important; 
        border-bottom-right-radius: 0.5rem !important; 
    }
</style>