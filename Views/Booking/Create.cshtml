@model FlightBooking.Models.Booking

@{
    ViewData["Title"] = "Xác nhận đặt vé";
}

<div class="container mt-5">
    <div class="card shadow-sm mx-auto" style="max-width: 550px; border-radius: 15px; border: none;">
        <div class="card-header bg-primary text-white text-center py-3" style="border-radius: 15px 15px 0 0;">
            <h4 class="mb-0"><i class="fas fa-file-invoice-dollar me-2"></i>Xác nhận đặt vé</h4>
        </div>
        <div class="card-body p-4">
            @* QUAN TRỌNG: Kiểm tra asp-controller và asp-action xem có đúng tên trong code C# không *@
            <form asp-controller="Booking" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                @* Dữ liệu ẩn để gửi về Server *@
                <input type="hidden" asp-for="FlightId" />
                <input type="hidden" asp-for="UserId" />
                
                @* Bổ sung thêm ngày đặt nếu Model yêu cầu, tránh lỗi DB *@
                <input type="hidden" name="BookingDate" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss")" />

                <div class="booking-details mb-4">
                    <div class="text-center mb-4">
                        <i class="fas fa-ticket-alt fa-3x text-primary mb-2"></i>
                        <p class="text-muted">Vui lòng kiểm tra lại thông tin chuyến bay của bạn</p>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary"><i class="fas fa-user me-2"></i>Hành khách:</span>
                            <strong class="text-dark">@User.Identity?.Name</strong>
                        </div>
                        
                        @if (Model.Flight != null)
                        {
                            <hr />
                            <div class="mb-2">
                                <span class="text-secondary small">Chuyến bay:</span><br />
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <strong class="fs-5 text-primary">@Model.Flight.FromCity</strong>
                                    <i class="fas fa-long-arrow-alt-right text-muted"></i>
                                    <strong class="fs-5 text-primary">@Model.Flight.ToCity</strong>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between mt-2">
                                <span class="text-secondary small">Giá vé:</span>
                                <strong class="text-danger">@Model.Flight.Price.ToString("N0") VNĐ</strong>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info py-2 mt-2 mb-0 small">
                                <i class="fas fa-info-circle me-1"></i> Thông tin chuyến bay đang được xử lý...
                            </div>
                        }
                    </div>

                    <div class="alert alert-warning py-2 border-0 shadow-sm mb-0" style="font-size: 0.85rem;">
                        <i class="fas fa-shield-alt me-1 text-warning"></i> 
                        Thông tin của bạn được bảo mật theo tiêu chuẩn quốc tế.
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg fw-bold shadow-sm py-3">
                        <i class="fas fa-check-circle me-2"></i>XÁC NHẬN & THANH TOÁN
                    </button>
                    <a asp-controller="Flight" asp-action="Search" class="btn btn-link text-decoration-none text-muted">
                        <i class="fas fa-times me-1"></i> Hủy giao dịch
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}